# ── Server environment ────────────────────────────────────────────
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file to Git.

# MongoDB connection (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Initial admin account (used only for first-boot seeding; password is
# hashed with bcrypt before storage — plaintext is never saved)
ADMIN_EMAIL=admin@soumik.dev
ADMIN_PASSWORD=change_this_strong_password

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Server port
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# ── Cloudinary (OPTIONAL but recommended for production) ─────────
# When all three are set, photos & resumes upload to Cloudinary.
# When empty, files are stored locally under server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
