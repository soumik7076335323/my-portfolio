# ── Client environment ────────────────────────────────────────────
# Copy to client/.env when needed.

# Base URL of the backend API.
# • Leave EMPTY in local development — the CRA dev server proxies
#   /api and /uploads to http://localhost:5000 (see "proxy" in package.json).
# • In production (frontend on Vercel, API on Render) set it to your API root, e.g.:
#   REACT_APP_API_URL=https://your-api.onrender.com
REACT_APP_API_URL=
